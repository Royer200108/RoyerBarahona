---
import { Image } from "astro:assets";


const frameworks = Object.entries(
  import.meta.glob("../assets/svg/frameworks/*.svg", {
    eager: true,
    import: "default",
  }),
).map(([path, src]) => ({
  nombre: path.split("/").pop()?.replace(".svg", "") || "",
  src: src as string,
}));

const devops = Object.entries(
  import.meta.glob("../assets/svg/devops/*.svg", {
    eager: true,
    import: "default",
  }),
).map(([path, src]) => ({
  nombre: path.split("/").pop()?.replace(".svg", "") || "",
  src: src as string,
}));

const databases = Object.entries(
  import.meta.glob("../assets/svg/databases/*.svg", {
    eager: true,
    import: "default",
  }),
).map(([path, src]) => ({
  nombre: path.split("/").pop()?.replace(".svg", "") || "",
  src: src as string,
}));

const languajes = Object.entries(
  import.meta.glob("../assets/svg/languajes/*.svg", {
    eager: true,
    import: "default",
  }),
).map(([path, src]) => ({
  nombre: path.split("/").pop()?.replace(".svg", "") || "",
  src: src as string,
}));

const sections = [
  {section: "frameworks", title:"Frameworks", icons:frameworks},
  {section: "devops", title:"DevOps y Cloud", icons:devops},
  {section: "languajes", title:"Lenguajes de Programación", icons:languajes},
  {section: "databases", title:"Bases de Datos", icons:databases},
  ]
---

<section
  id="habilities"
  class="w-full px-50 flex flex-col justify-between pt-20
  max-2xl:px-5
  max-lg:flex-col max-lg:px-5"
>
  <div>
    <h3 class="sub-titulo text-2xl font-bold mb-2">
      <span class="flex items-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="rgb(34, 154, 136)"
          class="icon icon-tabler icons-tabler-filled icon-tabler-circle"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path
            d="M7 3.34a10 10 0 1 1 -4.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 4.995 -8.336z"
          ></path>
        </svg>

        &nbspHabilidades
      </span>
    </h3>
  </div>

  <div class=" w-full flex
  max-lg:flex-col
  ">
    <article class="habilidades-activa flex-col w-1/2 h-150 gap-2
    max-lg:w-full mx-lg:mb-10 max-lg:order-2
    "
    id="hard-skills-article"
    >
      {
        sections.map((section) => (
          <h4 class="pb-2 text-1xl font-bold">{section.title}: </h4>

          <div class="slider w-full">
            <div class="flex" id={section.section}>
              {
                [...section.icons, ...section.icons].map((icon) => (
                  <div class="slide flex justify-center items-center gap-2">
                    <div class="slide-contenido items-center h-full flex gap-2 py-2 px-4 rounded-xl">
                      <Image src={icon.src} alt={icon.nombre} width={29} height={31} />
                      <span>{icon.nombre}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        ))
      }

    </article>

     <article class="habilidades-inactiva flex-col w-1/2 h-170 gap-10
    max-lg:w-full mx-lg:mb-10 max-lg:order-2
    "
    id="soft-skills-article"
    >
      habilidades blandas

    </article>

    <article class="flex flex-col w-1/2 h-150 gap-10 items-center justify-center
    max-lg:w-full mx-lg:mb-10 max-lg:order-1
    ">

    <div class="wrap-toggle w-full h-50 flex items-center justify-center">
      <input type="checkbox" id="toggle" class="offscreen">
      <label for="toggle" class="switch flex justify-between items-center px-5 rounded-xl">
        <span class="text-[#fff] font-bold">Soft Skills</span>
        <span class="text-[#229a88] font-bold">Hard Skills</span>
      </label>
    </div>

    <div class="w-full h-100 px-15 texto-activo" id="hard-skills">
      <h1
        class="texto-animado habilidades font-bold text-4xl
      max-lg:text-4xl
      max-sm:text-wrap"
      >
        Hard Skills
      </h1>

      <p class="parrafo parrafo-habilidades text-1xl">
        Mi experiencia se ha orientado más al desarrollo de <strong>Aplicaciones Web</strong> que incluyen despliegues en la nube con entregas continuas, sin embargo también he realizado proyectos de <strong>Escritorio</strong> y <strong>Móviles</strong>.
      </p>
    </div>
    
    <div class="w-full h-100 px-15 texto-inactivo" id="soft-skills">
      <h1
        class="texto-animado habilidades font-bold text-4xl
      max-lg:text-4xl
      max-sm:text-wrap"
      >
        Soft Skills
      </h1>

      <p class="parrafo parrafo-habilidades text-1xl">
        También poseo habilidades blandas que me permiten trabajar de <strong>manera efectiva</strong> en equipo, relativa <strong>facilidad de comunicación</strong> y <strong>adaptabilidad</strong> en los entornos de trabajo. Esto me permite colaborar de forma efectiva en <strong>Equipos</strong> y contribuir al <strong>Éxito</strong> de los proyectos.
      </p>
    </div>

    </article>
  </div>
  
</section>

<script define:vars={{sections}}>
  let contador = 0;

  document.addEventListener("DOMContentLoaded", () => {
    sections.forEach((section) => {
      //Obtengo el elemento dentro del que se generan los items
    const track = document.getElementById(section.section);
    if (!track) return;

    //Obtengon un arreglo de los items totales (se espera que sean el doble de los originales)
    const slides = track.querySelectorAll(".slide");
    //Tomo el ancho del primer item de la lista (todos deberian tener el mismo ancho)
    const slideWidth = slides[0].offsetWidth || 200;
    //Tomo la cantidad real de items que ve el usuario
    const totalSlides = slides.length / 2;

    // Aplicar la animación con el tiempo deseado al carrusel
    track.style.animation = `scroll-${section.section} ${section.icons.length * 3}s linear infinite`;

    // Crear keyframe dinámico
    const style = document.createElement("style");
    style.textContent = `
      @keyframes scroll-${section.section} {
        ${contador%2 === 0 ?
        `0% { transform: translateX(0); }
        100% { transform: translateX(-${slideWidth * totalSlides}px); }}`
        :
        `0% { transform: translateX(-${slideWidth * totalSlides}px); }
        100% { transform: translateX(0); }}`
      }
    `;
    //Agrega el kreyframe al css para que se aplique al carrusel
    document.head.appendChild(style);
    contador++;
    })

    const checkbox = document.getElementById('toggle');
    if(!checkbox) return;
    const hardSkillsDiv = document.getElementById('hard-skills');
    if(!hardSkillsDiv) return;
    const softSkillsDiv = document.getElementById('soft-skills');
    if(!softSkillsDiv) return;

    const hardSkillsArticle = document.getElementById('hard-skills-article');
    if(!hardSkillsArticle) return;
    const softSkillsArticle = document.getElementById('soft-skills-article');
    if(!softSkillsArticle) return;

    checkbox.addEventListener('change', () => {
      if (checkbox.checked) {
        softSkillsDiv.classList.add('texto-activo');
        softSkillsDiv.classList.remove('texto-inactivo');

        hardSkillsDiv.classList.remove('texto-activo');
        hardSkillsDiv.classList.add('texto-inactivo');

        softSkillsArticle.classList.add('habilidades-activa');
        softSkillsArticle.classList.remove('habilidades-inactiva');

        hardSkillsArticle.classList.remove('habilidades-activa');
        hardSkillsArticle.classList.add('habilidades-inactiva');
      } else {
        hardSkillsDiv.classList.add('texto-activo');
        hardSkillsDiv.classList.remove('texto-inactivo');

        softSkillsDiv.classList.remove('texto-activo');
        softSkillsDiv.classList.add('texto-inactivo');

        hardSkillsArticle.classList.add('habilidades-activa');
        hardSkillsArticle.classList.remove('habilidades-inactiva');

        softSkillsArticle.classList.remove('habilidades-activa');
        softSkillsArticle.classList.add('habilidades-inactiva');
      }

    });
  });


  

  
</script>
