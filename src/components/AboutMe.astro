---
import { Image } from "astro:assets";
import roger from "../assets/images/roger.png";

const icons = Object.entries(
  import.meta.glob("../assets/svg/*.svg", {
    eager: true,
    import: "default",
  }),
).map(([path, src]) => ({
  nombre: path.split("/").pop()?.replace(".svg", "") || "",
  src: src as string,
}));

icons.sort((a, b) => a.nombre.localeCompare(b.nombre));

//console.log(icons);

import Button from "../components/Button.astro";
---

<section
  id="about-me"
  class="w-full px-50 flex justify-between pt-30
  max-2xl:px-5
  max-lg:flex-col max-lg:items-center max-lg:px-5"
>
  <article class="w-1/2 pt-10
    
