---
import { Image } from "astro:assets";

import "../styles/global.css";
import Logo from "../assets/images/Logo.png";

const navItems = [
  { code: "aboutMe", title: "Sobre Mí", href: "#about-me", active: true },
  { code: "habilities", title: "Habilidades", href: "#habilities", active: false },
  { code: "projects", title: "Proyectos", href: "#projects", active: false },
  { code: "contact", title: "Contacto", href: "#contact", active: false },
];
---

<section class="navigation w-full flex flex-row fixed">
  <div class="w-3/6 px-15 flex items-center   
  max-xl:w-1/6
  max-2xl:w-1/6
  max-md:w-1/6
  max-lg:w-5/6 max-lg:px-5
  max-sm:w-5/6">
    <Image class="logo" src={Logo} alt="Logo" />
  </div>

  <div class="w-2/6 justify-between block 
  max-xl:w-4/6
  max-2xl:w-4/6
  max-md:w-4/6
  max-lg:w-4/6
  max-lg:hidden">
    <nav class="w-full h-full flex items-center justify-between">
      <ul class="flex w-full justify-around items-center h-full">
        {
          navItems.map((item) => (
            <li>
              <a
                data-code={item.code}
                class:list={{ active: item.active }}
                class="flex items-center justify-center text-white"
                href={item.href}
              >
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="w-1/6 px-15 flex justify-end items-center 
  max-xl:w-1/6
  max-2xl:w-1/6
  max-md:w-1/6
  max-lg:w-1/6 max-lg:px-5
  max-sm:w-1/6">
    <button class="">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="35"
        height="35"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="icon icon-tabler icons-tabler-filled icon-tabler-moon"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path
          d="M12 1.992a10 10 0 1 0 9.236 13.838c.341 -.82 -.476 -1.644 -1.298 -1.31a6.5 6.5 0 0 1 -6.864 -10.787l.077 -.08c.551 -.63 .113 -1.653 -.758 -1.653h-.266l-.068 -.006l-.06 -.002z"
        ></path>
      </svg>
    </button>
  </div>
</section>

<script>
  const nav = document.querySelector("nav");

  nav?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const link = target.closest("a");

    if (!link) return;

    // Quitar active de todos
    nav.querySelectorAll('a').forEach((item) => {
      item.classList.remove('active');
    });

    link.classList.add("active");
  });
</script>
