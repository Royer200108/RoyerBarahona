---

<section
  id="projects"
  class="w-full h-screen px-50 flex flex-col pt-30 gap-20
  max-2xl:px-5
  max-lg:h-auto max-lg:flex-col max-lg:px-5 max-lg:gap-5"
>
  <div>
    <h3 class="sub-titulo text-2xl font-bold mb-2">
      <span class="flex items-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="rgb(34, 154, 136)"
          class="icon icon-tabler icons-tabler-filled icon-tabler-circle"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path
            d="M7 3.34a10 10 0 1 1 -4.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 4.995 -8.336z"
          ></path>
        </svg>

        &nbspProyectos
      </span>
    </h3>

    <p class="parrafo text-1xl">
      Aquí podrá encontrar listados algunos de mi <strong>Experiencia</strong> y <strong
        >Proyectos</strong
      > más relevantes en los que he tenido oportunidad de desempeñarme junto a una
      pequeña descripción de las <strong>Tareas</strong> realizadas y las <strong
        >Tecnologías</strong
      > empleadas en los mismos.
    </p>
  </div>

  <div class="w-full flex
  max-lg:h-auto max-lg:flex-col">
    <article
      class="w-1/2 items-center
      max-lg:w-full mx-lg:mb-10 max-lg:order-2 max-lg:h-auto"
      id="soft-skills-article"
    >
      <div
        class="flex flex-col items-center
      max-xl:flex-nowrap max-xl:flex-col max-xl:gap-2
      max-lg:w-full max-lg:h-full max-lg:gap-2 max-lg:flex-col max-lg:flex-nowrap
      max-sm:mt-10 max-sm:gap-10 max-sm:h-auto"
      >
        {
          experiences.slice(0,2).map((experience) => (
            <div
              class="px-2 pb-5
            max-xl:w-full
            max-sm:p-0
            "
            >
              <div
                class="flex items-start p-3 rounded-xl
              max-sm:p-1 max-sm:h-auto
              "
              >
                <div
                  class="w-1/3 flex
                max-xl:items-center max-xl:justify-center
                "
                >
                  <span class="date-span flex items-center justify-center">
                    {experience.date}
                  </span>
                </div>

                <div class="w-2/3">
                  <div>
                    <span class="">
                      <h3 class="font-bold mb-2">{experience.title}</h3>
                    </span>
                    <span>
                      <p class="text-sm">{experience.description}</p>
                    </span>
                  </div>
                  <div class="w-full h-auto flex gap-2 mt-2">
                    {
                      experience.technologies.map((technology) => (
                        //<Image src={technology.href} alt={technology.title} width={29} height={31} />
                        <Image
                          src={getImage(technology.href)}
                          alt={technology.title}
                          width={25}
                          height={25}
                        />
                      ))
                      //<Image src={getImage('svg/frameworks/Tailwind.svg')} alt="Logo" width={25} height={25}></Image>
                    }
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </article>

    <article
      class="w-1/2 items-center
      max-lg:w-full mx-lg:mb-10 max-lg:order-2 max-lg:h-auto"
      id="soft-skills-article"
    >
      <div
        class="flex flex-col items-center
        max-xl:flex-nowrap max-xl:flex-col max-xl:gap-2
        max-lg:w-full max-lg:h-full max-lg:gap-2 max-lg:flex-col max-lg:flex-nowrap
        max-sm:mt-10 max-sm:gap-10 max-sm:h-auto"
      >
        {
          projects.slice(0,2).map((project) => (
            <div
              class="px-2 pb-5
              max-xl:w-full
              max-sm:p-0
              "
            >
              <div
                class="flex items-start p-3 rounded-xl
                max-sm:p-1 max-sm:h-auto
                "
              >
                <div
                  class="w-1/3 flex
                  max-xl:items-center max-xl:justify-center
                  "
                >
                  <span class="date-span flex items-center justify-center">
                    {project.date}
                  </span>
                </div>

                <div class="w-2/3">
                  <div>
                    <span class="">
                      <h3 class="font-bold mb-2">{project.name}</h3>
                    </span>
                    <span>
                      <p class="text-sm">{project.description}</p>
                    </span>
                  </div>
                  <div class="w-full h-auto flex gap-2 mt-2">
                    {project.technologies?.map(
                      (technology) =>
                        technology && (
                          <Image
                            src={getImage(technology.href)}
                            alt={technology.title}
                            width={25}
                            height={25}
                          />
                        ),
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </article>
  </div>
</section>
